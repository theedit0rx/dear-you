{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://your-production-domain.example",
          "http://localhost:3000"
        ],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["Content-Type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
