# PostgreSQL is used by the Next.js adapter in this project.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional deployed Cloudflare Worker origin (leave unset for PostgreSQL-backed local API routes).
# Use a real same-site custom API origin, without a trailing slash.
# NEXT_PUBLIC_DEAR_YOU_API_URL=https://api.your-real-domain.tld

# Optional Stripe TEST-mode subscription configuration only. Never place these in client code.
# STRIPE_SECRET_KEY=sk_test_replace_with_real_test_key
# STRIPE_PRICE_ID=price_replace_with_real_recurring_test_price
# STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_test_webhook_secret
